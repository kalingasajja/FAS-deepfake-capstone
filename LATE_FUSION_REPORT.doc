    </tr>
    <tr>
        <th rowspan="2" style="background:#e2e8f0;">True Class</th>
        <th style="background:#f8fafc;">Authentic Real (38)</th>
        <td style="background:#dcfce7; font-weight:bold; color:#166534;">TN = 37 (97.4%)</td>
        <td style="background:#fee2e2; color:#991b1b;">FP = 1 (2.6%)</td>
    </tr>
    <tr>
